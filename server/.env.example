# Leave empty to run with an in-memory database (dev only, wiped on restart)
MONGODB_URI=
MONGODB_DB=sidequests
# https://ux.priorlabs.ai -> API token. Empty = heuristic odds only
TABPFN_TOKEN=
# Empty = the browser's built-in voice is used instead
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
SENTRY_DSN=
# Comma-separated list of websites allowed to call this API
CORS_ORIGINS=http://localhost:5173
# TabPFN free-tier guard (real limits: 5M/day, 20M/month). Defaults: 3.75M/day, 15M/month
TABPFN_DAILY_CAP=3750000
TABPFN_MONTHLY_CAP=15000000
TABPFN_MAX_CALLS_PER_MINUTE=30
TABPFN_MAX_CALLS_PER_USER_DAY=40
# ElevenLabs free-tier guard (10k credits/month). Default 14k chars ≈ 7k credits
ELEVENLABS_MONTHLY_CHAR_CAP=14000
ELEVENLABS_MAX_LINES_PER_USER_DAY=15
